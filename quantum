def compute_cpsi(data_matrix):
    if data_matrix.shape[1] < 2: return None
    data = (data_matrix - data_matrix.mean(axis=0)) / (data_matrix.std(axis=0) + 1e-10)
    C_mat = np.corrcoef(data.T)
