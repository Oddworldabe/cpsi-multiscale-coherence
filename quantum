    sz_ops = []
    for i in range(N):
        o = [qt.qeye(2)]*N; o[i] = qt.sigmaz()
        sz_ops.append(qt.tensor(o))
    
    # 5 trajectoires random
    tlist = np.linspace(0, 80, 400)
