    for trial in range(5):
        psi0 = qt.Qobj(qt.rand_ket(dim).full(), dims=[[2]*N, [1]*N])
        rho0 = qt.ket2dm(psi0)
        
        # mesolve avec H comme e_op aussi pour avoir E(t)
        result = qt.mesolve(H, rho0, tlist, c_ops, sz_ops + [H])
        
