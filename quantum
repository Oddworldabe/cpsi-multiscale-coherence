    r2 = 1 - np.sum((C_a - X@b)**2) / np.sum((C_a - C_a.mean())**2)
    
    print(f"\n  FIT : C = {b[0]:.4f} * (-F) + {b[1]:.4f}")
    print(f"  R2 = {r2:.4f}")
    
