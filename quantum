                surprise = sum(-np.clip(p,1e-10,1-1e-10)*np.log(np.clip(p,1e-10,1-1e-10))
                              -(1-np.clip(p,1e-10,1-1e-10))*np.log(1-np.clip(p,1e-10,1-1e-10))
                              for p in probs) / N
                
                # Conductance
