        ('feedback_0.5', lambda C, t: max(0.001, 0.5 * (1 - C))),
        ('feedback_1.0', lambda C, t: max(0.001, 1.0 * (1 - C))),
        ('ramp_down', lambda C, t: max(0.001, 0.5 * np.exp(-t / 20))),
    ]:
        rho = qt.ket2dm(psi0)
        E_init = qt.expect(H, rho)
