            C_test.append(C)
        C_test = np.array(C_test)
        
        try:
            popt_t, _ = curve_fit(exp_relax, tlist, C_test, p0=[C_test[-1], C_test[0], gamma_test], maxfev=5000)
            lam = popt_t[2]
            r2 = 1 - np.sum((C_test - exp_relax(tlist, *popt_t))**2) / np.sum((C_test - C_test.mean())**2)
